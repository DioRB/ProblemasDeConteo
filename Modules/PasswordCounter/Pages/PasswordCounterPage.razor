@page "/passwords"
@using System.Numerics;
@using Problemas_de_Conteo.Modules.PasswordCounter.Models;
@using Problemas_de_Conteo.Modules.PasswordCounter.Services;
@inject IJSRuntime JS

@inject PasswordCountService PasswordCountService
@inject PasswordValidatorService PasswordValidatorService




<PageTitle>Contador</PageTitle>

<div class="academic-container">
    <h1 class="main-title">Análisis de Espacios de Contraseñas</h1>
    <p class="subtitle">
        Cálculo del cardinal del espacio muestral bajo restricciones combinatorias mediante el Principio de Inclusión-Exclusión.
    </p>

    <hr class="academic-divider" />

    <div class="grid-layout-2col">
        <div class="parameter-section">
            <h3>1. Dimensiones del Problema</h3>

            <div class="input-group">
                <label>Longitud de la cadena (k):</label>
                <input type="number" min="1" step="1" @bind="Config.Length" />
            </div>

            <div class="input-group">
                <label>Tamaño del alfabeto (n):</label>
                <input type="number" min="1" step="1" @bind="Config.AlphabetSize" />
            </div>

            <div class="input-group checkbox-group">
                <input type="checkbox" id="chkRepetition" @bind="Config.AllowRepetition" />
                <label for="chkRepetition">Permitir repetición de elementos</label>
            </div>
        </div>

        <div class="parameter-section">
            <h3>2. Subconjuntos de Caracteres</h3>

            <div class="ux-note">
                <strong>Nota de modelado:</strong> Para que el cálculo sea exacto, los subconjuntos deben ser <em>disjuntos</em> (mutuamente excluyentes). Por ejemplo, no crees un grupo "Letras" y un grupo "Vocales" al mismo tiempo, ya que se superponen.
            </div>

            @foreach (var group in Config.Groups)
            {
                <div class="group-row">
                    <input type="text" @bind="group.Name" class="group-name-input" placeholder="Nombre del grupo" />

                    <div class="size-and-action">
                        <input type="number" min="0" @bind="group.Size" title="Cantidad de caracteres" class="group-size-input" />
                        <button class="delete-btn" @onclick="() => RemoveGroup(group)" title="Eliminar grupo">&times;</button>
                    </div>
                </div>
            }

            <button class="secondary-btn" @onclick="AddGroup">+ Agregar subconjunto</button>
        </div>
    </div>

    <hr class="academic-divider" />

    <div class="parameter-section">
        <h3>3. Restricciones de Inclusión ("Al menos uno")</h3>

        <div class="checkbox-row">

            @foreach (var group in Config.Groups)
            {
                <div class="checkbox-group">

                    <input type="checkbox"
                           @bind="group.Required" />

                    <label>
                        Debe contener al menos un @group.Name
                    </label>

                </div>
            }

        </div>

    </div>

    <br />
    <button class="primary-btn" @onclick="Calculate">Calcular</button>

    @if (!string.IsNullOrWhiteSpace(ValidatorMessage))
    {
        <div class="validation-box">
            <strong>Inconsistencia detectada:</strong>
            <p>@ValidatorMessage</p>
        </div>
    }

    @if (Result is not null && string.IsNullOrWhiteSpace(ValidatorMessage))
    {
        <div class="result-box">
            <h3>Desarrollo Analítico</h3>
            <p>(Verificar resultado del procedimiento. Puede que según la complejidad, la cadena aritmética sea incorrecta)</p>
            <p>Aplicando conteo estructurado para <i>n</i> elementos y longitud <i>k</i>, obtenemos el siguiente desarrollo:</p>
            <div class="math-container">
                <div id="math-output"></div>
            </div>
        </div>
    }
</div>




@code {
    private PasswordConfig Config = new()
        {
            Groups =
        [
            new()
            {
                Name = "Dígitos",
                Size = 10
            },

            new()
            {
                Name = "Mayúsculas",
                Size = 26
            },

            new()
            {
                Name = "Símbolos",
                Size = 10
            }
        ]
        };

    private BigInteger? Result;
    private string ValidatorMessage = "";
    private IJSObjectReference? _module;
    private bool _shouldRenderMath = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRenderMath)
        {
            _shouldRenderMath = false;

            await Task.Delay(50);

            await RenderMath();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            await _module.DisposeAsync();
    }

    private void Calculate()
    {

        ValidatorMessage = PasswordValidatorService.Validate(Config);

        if (!string.IsNullOrWhiteSpace(ValidatorMessage))
            return;

        Result = PasswordCountService.CountPasswords(Config);

        _shouldRenderMath = true;
    }

    private async Task RenderMath()
    {
        if (Result is null)
            return;

        try
        {
            _module ??=
                await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    $"./js/mathjax-helper.js?v={DateTime.Now.Ticks}");

            string latex = BuildPasswordLatex();

            await _module.InvokeVoidAsync(
                "renderMath",
                "math-output",
                latex + $" = {Result}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private List<CharacterGroup> GetRequiredGroups()
    {
        return Config.Groups
            .Where(g => g.Required)
            .ToList();
    }

    private string BuildRepetitionLatex()
    {
        string total =
            $"{Config.AlphabetSize}^{{{Config.Length}}}";

        var groups = GetRequiredGroups();

        if (!groups.Any())
            return total;

        List<string> exclusions = new();

        int subsets = 1 << groups.Count;

        for (int mask = 1; mask < subsets; mask++)
        {
            int removed = 0;
            int selectedGroups = 0;

            for (int i = 0; i < groups.Count; i++)
            {
                if ((mask & (1 << i)) != 0)
                {
                    removed += groups[i].Size;
                    selectedGroups++;
                }
            }

            string term =
                $"({Config.AlphabetSize - removed})^{{{Config.Length}}}";

            if (selectedGroups % 2 == 1)
                exclusions.Add(term);
            else
                exclusions.Add("-" + term);
        }

        string innerLatex = string.Join(" + ", exclusions).Replace("+ -", "- ");
        return total + @" - \left[" + innerLatex + @"\right]";
    }

    private string BuildNoRepetitionLatex()
    {
        string total =
                $@"P({Config.AlphabetSize},{Config.Length})
        =
        \frac{{{Config.AlphabetSize}!}}
        {{{Config.AlphabetSize - Config.Length}!}}";

        var groups = GetRequiredGroups();

        if (!groups.Any())
            return total;

        List<string> terms = new();

        int subsets = 1 << groups.Count;

        for (int mask = 1; mask < subsets; mask++)
        {
            int removed = 0;
            int selected = 0;

            for (int i = 0; i < groups.Count; i++)
            {
                if ((mask & (1 << i)) != 0)
                {
                    removed += groups[i].Size;
                    selected++;
                }
            }

            int remainingAlphabet =
                Config.AlphabetSize - removed;

            string denom = (remainingAlphabet - Config.Length) < 0
                ? null 
                : $"{remainingAlphabet - Config.Length}!";

            string term = denom is null
                ? "0"
                : $@"\frac{{{remainingAlphabet}!}}{{{denom}}}";

            if (selected % 2 == 1)
                terms.Add(term);
            else
                terms.Add("-" + term);
        }

        string innerLatex = string.Join(" + ", terms).Replace("+ -", "- ");
        return total + @" - \left[" + innerLatex + @"\right]";
    }

    private string BuildPasswordLatex()
    {
        if (Config.AllowRepetition)
        {
            return BuildRepetitionLatex();
        }

        return BuildNoRepetitionLatex();
    }

    private void AddGroup()
    {
        Config.Groups.Add(
            new CharacterGroup
                {
                    Name = $"Grupo {Config.Groups.Count + 1}",
                    Size = 1
                });
    }

    private void RemoveGroup(CharacterGroup group)
    {
        Config.Groups.Remove(group);
    }
}
